{
  "config": {
    "POSTGRES_PASSWORD": {
      "displayName": "Database Password",
      "description": "PostgreSQL password. Auto-generated during install."
    },
    "ADMIN_PASSWORD": {
      "displayName": "Admin Password",
      "description": "Password for the initial admin account. Auto-generated during install."
    },
    "DEFAULT_PHONE_REGION": {
      "displayName": "Default Phone Region",
      "description": "Country code used for phone number formatting. Nextcloud shows a warning if this is not set.",
      "options": {
        "US": { "label": "United States" },
        "GB": { "label": "United Kingdom" },
        "DE": { "label": "Germany" },
        "FR": { "label": "France" },
        "NL": { "label": "Netherlands" },
        "ES": { "label": "Spain" },
        "IT": { "label": "Italy" },
        "PT": { "label": "Portugal" },
        "BE": { "label": "Belgium" },
        "AT": { "label": "Austria" },
        "CH": { "label": "Switzerland" },
        "SE": { "label": "Sweden" },
        "NO": { "label": "Norway" },
        "DK": { "label": "Denmark" },
        "PL": { "label": "Poland" },
        "AU": { "label": "Australia" },
        "CA": { "label": "Canada" },
        "BR": { "label": "Brazil" },
        "IN": { "label": "India" },
        "JP": { "label": "Japan" },
        "KR": { "label": "South Korea" },
        "CN": { "label": "China" },
        "RU": { "label": "Russia" },
        "TR": { "label": "Turkey" },
        "MX": { "label": "Mexico" }
      }
    }
  },
  "services": {
    "postgres": {
      "environment": {
        "POSTGRES_DB": {
          "description": "Name of the PostgreSQL database used by Nextcloud."
        },
        "POSTGRES_USER": {
          "description": "PostgreSQL username for Nextcloud."
        },
        "PGDATA": {
          "description": "Data directory inside the container. Do not change."
        }
      }
    },
    "nextcloud": {
      "environment": {
        "POSTGRES_HOST": {
          "description": "Hostname of the PostgreSQL database server."
        },
        "POSTGRES_DB": {
          "description": "PostgreSQL database name."
        },
        "POSTGRES_USER": {
          "description": "PostgreSQL username."
        },
        "NEXTCLOUD_ADMIN_USER": {
          "description": "Username for the initial admin account."
        },
        "NEXTCLOUD_ADMIN_PASSWORD": {
          "description": "Password for the initial admin account. Auto-generated during install."
        },
        "NEXTCLOUD_TRUSTED_DOMAINS": {
          "description": "Space-separated list of domains allowed to access Nextcloud. Includes mDNS hostname when available."
        },
        "REDIS_HOST": {
          "description": "Hostname of the Redis cache server."
        },
        "TZ": {
          "description": "Timezone for Nextcloud (e.g. America/New_York)."
        }
      },
      "notices": {
        "login-credentials": {
          "title": "Login Credentials",
          "elements": {
            "username": {
              "label": "Username"
            },
            "password": {
              "label": "Password"
            }
          }
        }
      }
    }
  }
}
